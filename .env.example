# ===================== Warungpedia Environment =====================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. The service role key must NEVER be exposed
# to browser/client code.

# --- App ---
# Public URL of the deployed app (used for SEO metadata / links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Alias used in-app (see section 7 of the spec). Also known as publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Supabase (server-only, NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase RLS helper user / JWT secret (server-only) ---
SUPABASE_JWT_SECRET=your-jwt-secret

# --- AI Moderation (server-only) ---
AI_MODERATION_API_KEY=your-ai-moderation-key

# --- Email provider (server-only) ---
EMAIL_PROVIDER_API_KEY=your-email-provider-key

# --- Payment provider (server-only) ---
PAYMENT_PROVIDER_SECRET=your-payment-provider-secret
